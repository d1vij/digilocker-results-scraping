{
    "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
    "files": {
        "include": ["src/**/*", "data/**/*", "test/**/*", "biome.json"]
    },
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        },
        "ignore": ["dist", "node_modules"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "ignore": ["dist", "node_modules"]
    },
    "vcs": {
        "enabled": true,
        "useIgnoreFile": true,
        "clientKind": "git"
    }
}
