{
    "name": "digilocker-results-scraping",
    "version": "0.1.0",
    "description": "Scraping CBSE 2026 results using digilocker's api.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "scripts": {
        "build": "bunup",
        "dev": "bunup --watch",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "tsc": "tsc --noEmit",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "release": "bumpp --commit --push --tag",
        "publish:ci": "bun publish --access public --no-git-checks",
        "prepare": "husky"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "radashi": "^12.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@types/bun": "^1.3.14",
        "bumpp": "^10.1.0",
        "bunup": "^0.5.6",
        "husky": "^9.1.7",
        "typescript": "^5.8.3",
        "vitest": "^3.1.2"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d1vij/digilocker-results-scraping.git"
    },
    "homepage": "https://github.com/d1vij/digilocker-results-scraping#readme"
}
