{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "isolatedDeclarations": true,
        "rootDir": ".",
        "outDir": "./dist",
        "baseUrl": ".",
        "types": ["@types/bun"],
        "paths": {
            "~/*": ["src/*"],
            "#/*": ["data/*"]
        }
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules", "dist"]
}
